# Normalize line endings so a Windows checkout and a Linux CI runner agree.
# Without this, Git for Windows (autocrlf=true by default) can commit CRLF
# and the build behaves differently locally than it does in Actions.

* text=auto

# These run on Linux in GitHub Actions — they must stay LF.
*.yml  text eol=lf
*.yaml text eol=lf
*.sh   text eol=lf

# Web sources: LF everywhere keeps diffs clean.
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.svg  text eol=lf
*.xml  text eol=lf

# Never touch these.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.pdf   binary
*.woff2 binary
